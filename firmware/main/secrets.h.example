#pragma once
/*
 * Copy to secrets.h and fill in. secrets.h is gitignored.
 */

/* ---------------------------------------------------------------------------
 * Tempest (outdoor)
 *
 * Only needed for the REST forecast poll. Live observations arrive over the
 * hub's unauthenticated UDP broadcast and need no credentials at all.
 *
 * tempestwx.com -> Settings -> Data Authorizations -> Create Token
 * ------------------------------------------------------------------------- */
#define TEMPEST_API_TOKEN   "00000000-0000-0000-0000-000000000000"

/* ---------------------------------------------------------------------------
 * Nest thermostat (indoor), via the Smart Device Management API
 *
 * Leave the refresh token empty to disable the indoor tiles entirely -- the
 * outdoor half of the display works without any of this.
 *
 * Full setup, including the one-time $5 Device Access registration fee, is in
 * docs/nest-api.md. Short version:
 *   1. Register a project at console.nest.google.com/device-access  ($5)
 *   2. Create an OAuth client (Web application) in Google Cloud Console
 *   3. Enable the Smart Device Management API on that Cloud project
 *   4. Authorise once in a browser, exchange the code for a refresh token
 *   5. GET the devices list to find your thermostat's device id
 *
 * The refresh token does not expire on a timer, but IS revoked by a Google
 * password change or by withdrawing access in the account's security settings.
 * If the indoor tiles stop updating, that is the first thing to check.
 * ------------------------------------------------------------------------- */
#define NEST_CLIENT_ID      ""    /* NNN-xxxx.apps.googleusercontent.com   */
#define NEST_CLIENT_SECRET  ""    /* GOCSPX-xxxx                            */
#define NEST_REFRESH_TOKEN  ""    /* starts "1//" -- keep the slashes       */
#define NEST_PROJECT_ID     ""    /* Device Access project UUID             */
#define NEST_DEVICE_ID      ""    /* from the devices list, after "devices/" */
