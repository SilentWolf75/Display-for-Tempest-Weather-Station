#pragma once
/*
 * Copy to secrets.h and fill in. secrets.h is gitignored.
 *
 * Only one credential is needed, and only for the REST forecast poll and the
 * one-shot history backfill. Live observations arrive over the hub's
 * unauthenticated UDP broadcast, and indoor readings come from a local I2C
 * sensor -- neither needs any account.
 *
 * Get a personal access token at:
 *   tempestwx.com -> Settings -> Data Authorizations -> Create Token
 *
 * CMake tracks creation and edits of secrets.h; a normal build is sufficient.
 */

#define TEMPEST_API_TOKEN   ""

/* ---------------------------------------------------------------------------
 * Wi-Fi
 *
 * Here rather than in Kconfig on purpose: sdkconfig is gitignored, but
 * sdkconfig.defaults is committed, and putting a password there is an easy
 * way to leak it into version control. This file is gitignored.
 * ------------------------------------------------------------------------- */
#define WIFI_SSID       ""
#define WIFI_PASSWORD   ""
